      "response_body": {
        "inline": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>altcha lab</title>\n    <script async defer type=\"module\" src=\"https://cdn.jsdelivr.net/npm/altcha@3.2.1/dist/main/altcha.min.js\"></script>\n  </head>\n  <body>\n    <form id=\"form\" method=\"post\" action=\"/verify\">\n      <label for=\"email\">Email</label>\n      <input id=\"email\" name=\"email\" type=\"email\" value=\"ada@example.com\" />\n      <altcha-widget\n        id=\"widget\"\n        name=\"altcha\"\n        auto=\"onload\"\n        challenge=\"/altcha/challenge\"\n      ></altcha-widget>\n      <button type=\"submit\">Send</button>\n    </form>\n\n    <script>\n      const widget = document.getElementById('widget');\n\n      widget.addEventListener('verified', async (event) => {\n        const payload = event.detail.payload;\n        window.__altchaPayload = payload;\n\n        const response = await fetch('/verify', {\n          method: 'POST',\n          headers: { 'content-type': 'application/json' },\n          body: JSON.stringify({ payload, email: document.getElementById('email').value }),\n        });\n\n        window.__altchaResult = await response.json();\n      });\n    </script>\n  </body>\n</html>\n",
