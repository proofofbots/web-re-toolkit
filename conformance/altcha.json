{
  "target": "altcha",
  "config": {
    "hmac_secret": "signature.secret",
    "workers": 4,
    "max_counter": 100000,
    "clock_ms": 1700000000000,
    "seed": 7
  },
  "cases": [
    {
      "name": "info reports the target",
      "op": "info",
      "params": {},
      "expect": { "target": "altcha" }
    },
    {
      "name": "one sha derivation matches the widget",
      "op": "derive_key",
      "params": {
        "algorithm": "SHA-256",
        "nonce": "000102030405060708090a0b0c0d0e0f",
        "salt": "aabbccddeeff00112233445566778899",
        "counter": 42,
        "cost": 1,
        "key_length": 32
      },
      "expect": { "key": "9efa368a91e3b314f130aeb951166ef9cb20a1cc5c35817f8c1e43723437f823" }
    },
    {
      "name": "one pbkdf2 derivation matches the widget",
      "op": "derive_key",
      "params": {
        "algorithm": "PBKDF2/SHA-256",
        "nonce": "000102030405060708090a0b0c0d0e0f",
        "salt": "aabbccddeeff00112233445566778899",
        "counter": 11,
        "cost": 5000,
        "key_length": 32
      },
      "expect": { "key": "83155c14e20e4f11e77e971f5b8d6a88a42a943262b61be4658e37df833d058c" }
    },
    {
      "name": "a v3 challenge solves to the counter the server used",
      "op": "solve",
      "params": {
        "challenge": {
          "parameters": {
            "algorithm": "SHA-256",
            "cost": 10,
            "keyLength": 32,
            "keyPrefix": "a9a9e81c084ad44c25351c5f5568ce22",
            "nonce": "9295b841727d48460ca4b4954584a14f",
            "salt": "b83df484bc74cdde5caad7992284ca01"
          },
          "signature": "b3aeb49b8a27accf753a38d53e180ce8aaf6cacf72480719f4872d884574a168"
        }
      },
      "expect": {
        "counter": 37,
        "derived_key": "a9a9e81c084ad44c25351c5f5568ce22229214aa726b13edb33baa9675fee5b3",
        "format": 3,
        "field": "altcha"
      }
    },
    {
      "name": "a legacy challenge solves and keeps the v1 payload shape",
      "op": "solve",
      "params": {
        "challenge": {
          "algorithm": "SHA-256",
          "challenge": "f4cb24d4a5bffabadd37c4ce3cfb5246adc8f2cb88e3e49497f0b3c3af90ffaf",
          "salt": "saltysalt?expires=1700000000",
          "signature": "c053bcd07083810a8a9412efb35168a56b6a2d8ca03bbe9e52ceceb69f591d9a"
        }
      },
      "expect": { "counter": 12345, "format": 1 }
    },
    {
      "name": "a solved v3 payload verifies against the server secret",
      "op": "verify",
      "params": {
        "challenge": {
          "parameters": {
            "algorithm": "SHA-256",
            "cost": 10,
            "keyLength": 32,
            "keyPrefix": "a9a9e81c084ad44c25351c5f5568ce22",
            "nonce": "9295b841727d48460ca4b4954584a14f",
            "salt": "b83df484bc74cdde5caad7992284ca01"
          },
          "signature": "b3aeb49b8a27accf753a38d53e180ce8aaf6cacf72480719f4872d884574a168"
        },
        "solution": {
          "counter": 37,
          "derivedKey": "a9a9e81c084ad44c25351c5f5568ce22229214aa726b13edb33baa9675fee5b3"
        }
      },
      "expect": {
        "verified": true,
        "expired": false,
        "invalid_signature": false,
        "invalid_solution": false
      }
    },
    {
      "name": "a tampered counter fails verification",
      "op": "verify",
      "params": {
        "challenge": {
          "parameters": {
            "algorithm": "SHA-256",
            "cost": 10,
            "keyLength": 32,
            "keyPrefix": "a9a9e81c084ad44c25351c5f5568ce22",
            "nonce": "9295b841727d48460ca4b4954584a14f",
            "salt": "b83df484bc74cdde5caad7992284ca01"
          },
          "signature": "b3aeb49b8a27accf753a38d53e180ce8aaf6cacf72480719f4872d884574a168"
        },
        "solution": {
          "counter": 38,
          "derivedKey": "a9a9e81c084ad44c25351c5f5568ce22229214aa726b13edb33baa9675fee5b3"
        }
      },
      "expect": { "verified": false, "invalid_solution": true, "invalid_signature": false }
    },
    {
      "name": "a created challenge is signed the way the widget expects",
      "op": "create_challenge",
      "params": {
        "algorithm": "SHA-256",
        "cost": 10,
        "counter": 37,
        "nonce": "9295b841727d48460ca4b4954584a14f",
        "salt": "b83df484bc74cdde5caad7992284ca01",
        "key_length": 32
      },
      "expect": { "format": 3, "algorithm": "SHA-256", "cost": 10 }
    },
    {
      "name": "obfuscated contact data decrypts",
      "op": "deobfuscate",
      "params": {
        "data": ""
      },
      "expect": { "text": "mailto:hidden@example.com" }
    },
    {
      "name": "a sentinel server signature verifies",
      "op": "server_signature",
      "params": {
        "payload": "",
        "fields": { "email": "user@example.com", "name": "Ada" }
      },
      "expect": {
        "verified": true,
        "expired": false,
        "invalid_signature": false,
        "fields_valid": true
      }
    },
    {
      "name": "interaction samples carry the arrays the collector exports",
      "op": "his",
      "params": { "width": 1440, "height": 900, "duration_ms": 1200 },
      "expect_keys": ["focus", "pointer", "scroll", "touch", "maxTouchPoints", "time"]
    },
    {
      "name": "solve needs a challenge or a url",
      "op": "solve",
      "params": {},
      "expect_error": "bad_input"
    },
    {
      "name": "an unsolvable challenge stops at the counter bound",
      "op": "solve",
      "params": {
        "max_counter": 500,
        "challenge": {
          "parameters": {
            "algorithm": "SHA-256",
            "cost": 1,
            "keyLength": 32,
            "keyPrefix": "ffffffffffffffffffffffffffffffff",
            "nonce": "9295b841727d48460ca4b4954584a14f",
            "salt": "b83df484bc74cdde5caad7992284ca01"
          }
        }
      },
      "expect_error": "internal"
    }
  ]
}
